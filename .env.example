# --- Ollama ---
# URL of your Ollama instance (reachable from the backend container)
OLLAMA_URL=http://ollama:11434
# Embedding model and its vector dimension
# nomic-embed-text=768, bge-m3=1024, mxbai-embed-large=1024, snowflake-arctic-embed2=1024
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- Qdrant (internal) ---
QDRANT_HOST=rag-qdrant
QDRANT_PORT=6333
# Set if you enable Qdrant API key auth (QDRANT__SERVICE__API_KEY on the qdrant service)
QDRANT_API_KEY=

# --- Host port mappings ---
QDRANT_HTTP_PORT=6353
QDRANT_GRPC_PORT=6354
BACKEND_PORT=8765
ADMIN_UI_PORT=8770
QUERY_UI_PORT=8771

# --- LLM (answer generation) ---
# Any Ollama chat/completion model, e.g. llama3.2:latest, qwen3:8b
LLM_MODEL=llama3.2:latest

# --- Reranker (TEI cross-encoder) ---
# TEI endpoint serving BAAI/bge-reranker-v2-m3. Set empty to use LLM-based scoring instead.
RERANKER_URL=http://reranker:80
# Cross-encoder model served by the reranker container
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Firecrawl (URL scraping) ---
# Self-hosted firecrawl-api endpoint; set API key only if your instance requires one
FIRECRAWL_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# Comma-separated CSS selectors excluded from every scrape (merged with per-request exclude_tags)
SCRAPE_EXCLUDE_TAGS=nav,header,footer,aside,script,style,noscript,iframe,form,[role=banner],[role=navigation],[role=dialog],[aria-modal=true],.modal,.popup,.overlay,.cookie-banner,.cookie-consent,.consent-banner,.country-banner,.country-selector,.cmp-country-banner,#country-banner-id,.nav,.navbar,.menu,.sidebar,.footer,.header,.advertisement,.ad,.social-share

# --- Cloudflare Tunnel ---
# Token from a Cloudflare Zero Trust tunnel. The cloudflared container starts by default and
# will restart until a valid token is supplied. Leave empty to run the stack locally without exposing it to the internet.
CLOUDFLARE_TUNNEL_TOKEN=
